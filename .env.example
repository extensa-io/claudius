# === Phase 0 (required) ===

# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js session secret (generate locally with: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AWS Bedrock credentials (IAM user with bedrock:InvokeModel permissions)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bootstrap admin email (the Google account that resolves to role: admin)
ADMIN_EMAIL=

# === Phase 1 (required) ===

# Tavily web search (powers the agent's web_search tool)
TAVILY_API_KEY=

# === Phase 2 (required) ===

# Voyage AI embeddings (voyage-4, 1024-dim) for document chunks
VOYAGE_API_KEY=

# Vercel Blob storage (direct client uploads of attached documents)
BLOB_READ_WRITE_TOKEN=

# === Phase 3 (required) ===

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# The memory-extraction and breaker-reset cron routes reject any request
# without it. Generate with: openssl rand -base64 32
CRON_SECRET=

# === Phase 4 (optional) ===

# LangSmith tracing. All optional: leave unset and tracing is simply off.
# Set LANGSMITH_TRACING=true plus an API key to turn it on; LangChain JS reads
# these directly from the environment and auto-instruments the agent graph.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=claudius
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
