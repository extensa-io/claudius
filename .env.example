# === Phase 0 (required) ===

# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js session secret (generate locally with: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AWS Bedrock credentials (IAM user with bedrock:InvokeModel permissions)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bootstrap admin email (the Google account that resolves to role: admin)
ADMIN_EMAIL=

# === Phase 1+ (uncomment as each phase arrives) ===

# Tavily web search (Phase 1)
# TAVILY_API_KEY=

# Voyage AI embeddings (Phase 2)
# VOYAGE_API_KEY=

# Vercel Blob storage (Phase 2)
# BLOB_READ_WRITE_TOKEN=

# LangSmith tracing (Phase 5)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=claudius
