# === Phase 0 (required) ===

# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js session secret (generate locally with: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AWS Bedrock credentials (IAM user with bedrock:InvokeModel permissions)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bootstrap admin email (the Google account that resolves to role: admin)
ADMIN_EMAIL=

# === Phase 1 (required) ===

# Tavily web search (powers the agent's web_search tool)
TAVILY_API_KEY=

# === Phase 2 (required) ===

# Voyage AI embeddings (voyage-4, 1024-dim) for document chunks
VOYAGE_API_KEY=

# Vercel Blob storage (direct client uploads of attached documents)
BLOB_READ_WRITE_TOKEN=

# === Phase 3 (required) ===

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# The memory-extraction and breaker-reset cron routes reject any request
# without it. Generate with: openssl rand -base64 32
CRON_SECRET=

# === Phase 4 (optional) ===

# LangSmith tracing. All optional: leave unset and tracing is simply off.
# Set LANGSMITH_TRACING=true plus an API key to turn it on; LangChain JS reads
# these directly from the environment and auto-instruments the agent graph.
# In Phase 5 the SAME flags, set on the Railway worker, trace a research run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=claudius
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# === Phase 5: Railway worker ===
#
# The worker (packages/worker) is a separate process and needs only a SUBSET of
# the vars above: MONGODB_URI, the three AWS_* vars, TAVILY_API_KEY,
# VOYAGE_API_KEY, BRAVE_API_KEY (required by the shared env schema), and
# optionally the LANGSMITH_* flags. It does NOT need
# AUTH_SECRET, AUTH_GOOGLE_*, ADMIN_EMAIL, BLOB_READ_WRITE_TOKEN, or CRON_SECRET
# (those are app-only; the shared env schema makes them optional so the worker
# runs without them). Set the worker's subset in the Railway service.
#
# How the worker consumes the `jobs` collection. Default (unset) uses a MongoDB
# change stream on inserts, which needs a replica set (Atlas M10+). Set to "poll"
# to use the timer-based fallback — the documented path for Atlas M0, which has
# no change streams.
# JOB_CONSUME_MODE=changestream

# === Phase 7 (required) ===

# Brave Search API (the answer engine's primary web-search backend; Tavily is
# demoted to fallback + high-value slot). Free tier is a monthly query allowance
# tracked in the `search` settings document. Get a key at
# https://api-dashboard.search.brave.com. Required in both runtimes because the
# engine lives in shared, though only the app's web_search tool uses it this phase.
BRAVE_API_KEY=
