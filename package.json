{
  "name": "claudius",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm -w @claudius/app run dev",
    "build": "npm -w @claudius/app run build",
    "start": "npm -w @claudius/app run start",
    "typecheck": "npm -ws run typecheck --if-present",
    "lint": "npm -ws run lint --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
