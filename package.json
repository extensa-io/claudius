{
  "name": "claudius",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm -w @claudius/app run dev",
    "build": "npm -w @claudius/app run build",
    "start": "npm -w @claudius/app run start",
    "typecheck": "npm -ws run typecheck --if-present",
    "lint": "npm -ws run lint --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:indexes": "npm -w @claudius/shared run db:indexes",
    "db:seed": "npm -w @claudius/shared run db:seed",
    "db:migrate:memory": "npm -w @claudius/shared run db:migrate:memory",
    "db:migrate:admin": "npm -w @claudius/shared run db:migrate:admin",
    "db:migrate:research": "npm -w @claudius/shared run db:migrate:research",
    "db:migrate:memory-management": "npm -w @claudius/shared run db:migrate:memory-management",
    "db:migrate:search": "npm -w @claudius/shared run db:migrate:search",
    "db:migrate:routing": "npm -w @claudius/shared run db:migrate:routing",
    "db:sync:pricing": "npm -w @claudius/shared run db:sync:pricing",
    "worker:dev": "npm -w @claudius/worker run dev"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "overrides": {
    "mongodb": "7.3.0"
  }
}
