engine-strict=true
# The @auth/mongodb-adapter peer-pins mongodb ^6, but we standardize on the
# latest driver (7.3.0) across both workspaces via the root "overrides". The
# adapter's MongoClient usage is stable across the 6->7 major, so we accept the
# peer mismatch rather than hold the whole repo back a major version.
legacy-peer-deps=true
